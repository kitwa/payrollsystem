{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=payroll.db"
  },
  "JwtSettings": {
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS_LONG_FOR_PRODUCTION",
    "ExpiryMinutes": "60",
    "RefreshTokenExpiryDays": "7"
  },
  "EmailSettings": {
    "Enabled": true,
    "Host": "smtp.example.com",
    "Port": 587,
    "User": "noreply@payrollsa.co.za",
    "Password": "CHANGE_THIS",
    "From": "noreply@payrollsa.co.za",
    "FromName": "Payroll SA"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/payrollsa-.log", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*"
}
